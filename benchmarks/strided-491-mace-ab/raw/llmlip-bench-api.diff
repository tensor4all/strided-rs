+//! Benchmark-only accessor for the scalar symmetric-contraction entry lists.
+//!
+//! Added for the strided-rs#491 A/B and **never enabled by default**. It adds no
+//! numerics: it returns the same nonzero entry lists `forward`/`vjp_x` iterate
+//! (`nonzero_entries`), which are private to this module.
+
+use super::*;
+
+/// One nonzero `U1` entry: `(ell, param, value)`.
+pub type U1Entry = (usize, usize, f64);
+/// One nonzero `U2` entry: `(left, right, param, value)`.
+pub type U2Entry = (usize, usize, usize, f64);
+/// One nonzero `U3` entry: `(left, right, inner, param, value)`.
+pub type U3Entry = (usize, usize, usize, usize, f64);
+
+/// The sparse entry lists of a scalar symmetric contraction.
+#[derive(Clone, Debug, Default)]
+pub struct ScalarSymEntries {
+    pub u1: Vec<U1Entry>,
+    pub u2: Vec<U2Entry>,
+    pub u3: Vec<U3Entry>,
+}
+
+/// The nonzero entry lists `forward`/`vjp_x` iterate for this contraction.
+pub fn scalar_sym_entries(
+    contraction: &MaceScalarSymmetricContraction<'_>,
+) -> Result<ScalarSymEntries> {
+    contraction.validate()?;
+    let entries = contraction.nonzero_entries();
+    Ok(ScalarSymEntries {
+        u1: entries
+            .u1
+            .iter()
+            .map(|entry| (entry.ell, entry.param, entry.value))
+            .collect(),
+        u2: entries
+            .u2
+            .iter()
+            .map(|entry| (entry.left, entry.right, entry.param, entry.value))
+            .collect(),
+        u3: entries
+            .u3
+            .iter()
+            .map(|entry| (entry.left, entry.right, entry.inner, entry.param, entry.value))
+            .collect(),
+    })
+}
