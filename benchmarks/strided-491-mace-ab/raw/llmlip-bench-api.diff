@@ -0,0 +1,340 @@
+//! Benchmark-only accessors for the layer-1 `conv_tp` (CG message) kernel.
+//!
+//! Added for the strided-rs#491 A/B and **never enabled by default**: it is
+//! `#[cfg(feature = "bench-api")]` and adds no numerics — every function
+//! forwards to the private kernel the model itself calls, and reports which
+//! dispatch path answered.
+//!
+//! The layer-1 geometry is the one llmlip ships for MACE-MP-0b3 medium: 10
+//! output blocks over `input_block_dims = [1,1,3,3,3,5,5,5,7,7]`, 128 features,
+//! in1 `128x0e+128x1o`, in2 `1x0e+1x1o+1x2e+1x3o`, out 5120, 1280 weights per
+//! edge. The per-block templates and CG tables are the baked constants
+//! (`MP0B_LAYER1_TP_TEMPLATES`, `MP0B_LAYER1_TP_CG{0..9}_F32`,
+//! `MP0B_LAYER1_HIDDEN_PATH_WEIGHTS`), i.e. the same data the fast path reads.
+
+use super::*;
+use e3nn_core::{Irrep, IrrepMul, Parity};
+
+/// One output block of the layer-1 `conv_tp` plan.
+#[derive(Clone, Debug)]
+pub struct Layer1Block {
+    /// Start of the block's in1 block in one in1 row (`0` or `128`).
+    pub x_base: usize,
+    /// In1 block width (`1` for `l=0`, `3` for `l=1`).
+    pub x_dim: usize,
+    /// Start of the block's in2 block in one in2 row (`0, 1, 4, 9`).
+    pub y_base: usize,
+    /// Start of the block's out block in one out row (`128 * cum_m`).
+    pub out_base: usize,
+    /// Out block width (`2l+1`).
+    pub out_dim: usize,
+    /// Start of the block's weight slice in one weight row (`128 * block`).
+    pub weight_base: usize,
+    /// e3nn normalization factor folded into the block's weights at load.
+    pub path_weight: f64,
+    /// `(i_m, j_m, k_m, scale)` of every nonzero CG entry of the block.
+    pub cg: Vec<(usize, usize, usize, f64)>,
+}
+
+/// The layer-1 `conv_tp` geometry the A/B needs, without touching the model.
+#[derive(Clone, Debug)]
+pub struct Layer1Descriptor {
+    pub feature_dim: usize,
+    pub in1_dim: usize,
+    pub in2_dim: usize,
+    pub out_dim: usize,
+    pub weight_numel: usize,
+    pub blocks: Vec<Layer1Block>,
+}
+
+/// A compiled layer-1 plan plus the identity output mask, held across calls so
+/// the timed window contains only the kernel.
+pub struct Layer1Plan {
+    plan: TensorProductPlan,
+    output_mask: Vec<f64>,
+    output_mask_f32: Vec<f32>,
+}
+
+impl Layer1Plan {
+    #[must_use]
+    pub fn plan(&self) -> &TensorProductPlan {
+        &self.plan
+    }
+}
+
+fn layer1_irreps(feature_dim: usize) -> Result<(Irreps, Irreps, Irreps), MaceLiteError> {
+    let even = |l: usize| Irrep::new(l, Parity::Even).map_err(MaceLiteError::from);
+    let odd = |l: usize| Irrep::new(l, Parity::Odd).map_err(MaceLiteError::from);
+    let mul = |mul: usize, irrep: Irrep| IrrepMul::new(mul, irrep).map_err(MaceLiteError::from);
+    let in1 = Irreps::new(vec![mul(feature_dim, even(0)?)?, mul(feature_dim, odd(1)?)?])
+        .map_err(MaceLiteError::from)?;
+    let in2 = Irreps::new(vec![
+        mul(1, even(0)?)?,
+        mul(1, odd(1)?)?,
+        mul(1, even(2)?)?,
+        mul(1, odd(3)?)?,
+    ])
+    .map_err(MaceLiteError::from)?;
+    let mut out_terms = Vec::with_capacity(MP0B_LAYER1_TP_TEMPLATES.len());
+    for template in MP0B_LAYER1_TP_TEMPLATES {
+        let l = (template.out_dim - 1) / 2;
+        let irrep = if l % 2 == 0 { even(l)? } else { odd(l)? };
+        out_terms.push(mul(feature_dim, irrep)?);
+    }
+    let out = Irreps::new(out_terms).map_err(MaceLiteError::from)?;
+    Ok((in1, in2, out))
+}
+
+/// The blocks of the layer-1 `conv_tp` plan, in plan order.
+#[must_use]
+pub fn layer1_descriptor() -> Layer1Descriptor {
+    let templates: &[Mp0bLayer1TpTemplate] = &MP0B_LAYER1_TP_TEMPLATES;
+    let tables: [&[Mp0bLayer1CgF32]; 10] = [
+        &MP0B_LAYER1_TP_CG0_F32,
+        &MP0B_LAYER1_TP_CG1_F32,
+        &MP0B_LAYER1_TP_CG2_F32,
+        &MP0B_LAYER1_TP_CG3_F32,
+        &MP0B_LAYER1_TP_CG4_F32,
+        &MP0B_LAYER1_TP_CG5_F32,
+        &MP0B_LAYER1_TP_CG6_F32,
+        &MP0B_LAYER1_TP_CG7_F32,
+        &MP0B_LAYER1_TP_CG8_F32,
+        &MP0B_LAYER1_TP_CG9_F32,
+    ];
+    let blocks = templates
+        .iter()
+        .zip(tables)
+        .zip(MP0B_LAYER1_HIDDEN_PATH_WEIGHTS)
+        .map(|((template, table), path_weight)| Layer1Block {
+            x_base: template.x_base,
+            x_dim: template.x_dim,
+            y_base: template.y_base,
+            out_base: template.out_base,
+            out_dim: template.out_dim,
+            weight_base: template.weight_base,
+            path_weight,
+            cg: table
+                .iter()
+                .map(|cg| (cg.i_m, cg.j_m, cg.k_m, f64::from(cg.scale)))
+                .collect(),
+        })
+        .collect::<Vec<_>>();
+    Layer1Descriptor {
+        feature_dim: MP0B_NUM_FEATURES,
+        in1_dim: MP0B_PRODUCT0_ROW_LEN,
+        in2_dim: MP0B_SH_DIM,
+        out_dim: MP0B_LAYER1_CONV_TP_OUTPUT_ROW_LEN,
+        weight_numel: MP0B_LAYER1_TP_TEMPLATES.len() * MP0B_NUM_FEATURES,
+        blocks,
+    }
+}
+
+/// Build the standard MACE-MP-0b3 layer-1 `conv_tp` plan.
+///
+/// The model path deserializes this plan from the converted checkpoint; this
+/// builds the same instruction list and CG table from the baked constants, so
+/// the fast-path predicate decides whether the fast kernel runs (it does).
+pub fn layer1_plan() -> Result<Layer1Plan, MaceLiteError> {
+    let descriptor = layer1_descriptor();
+    let (irreps_in1, irreps_in2, irreps_out) = layer1_irreps(descriptor.feature_dim)?;
+    let in1_layout = irreps_in1.checked_layout().map_err(MaceLiteError::from)?;
+    let in2_layout = irreps_in2.checked_layout().map_err(MaceLiteError::from)?;
+    let out_layout = irreps_out.checked_layout().map_err(MaceLiteError::from)?;
+    let mut instructions = Vec::with_capacity(descriptor.weight_numel);
+    let mut cg_entries = Vec::new();
+    for (block_index, block) in descriptor.blocks.iter().enumerate() {
+        let cg_offset = cg_entries.len();
+        for &(i_m, j_m, k_m, scale) in &block.cg {
+            cg_entries.push(CgEntry {
+                i_m,
+                j_m,
+                k_m,
+                value: scale,
+            });
+        }
+        for feature in 0..descriptor.feature_dim {
+            let in1_segment = in1_layout
+                .iter()
+                .position(|segment| segment.start == block.x_base + feature * block.x_dim)
+                .ok_or_else(|| {
+                    invalid_model(format!("layer1 in1 block {block_index} is not a segment"))
+                })?;
+            let in2_segment = in2_layout
+                .iter()
+                .position(|segment| segment.start == block.y_base)
+                .ok_or_else(|| {
+                    invalid_model(format!("layer1 in2 block {block_index} is not a segment"))
+                })?;
+            let out_segment = out_layout
+                .iter()
+                .position(|segment| segment.start == block.out_base + feature * block.out_dim)
+                .ok_or_else(|| {
+                    invalid_model(format!("layer1 out block {block_index} is not a segment"))
+                })?;
+            instructions.push(TensorProductInstruction {
+                in1_segment,
+                in2_segment,
+                out_segment,
+                cg_offset,
+                cg_len: block.cg.len(),
+                weight_offset: Some(block.weight_base + feature),
+                // The per-block normalization is prescaled into the weight tensor at
+                // model load (`mace_lite.rs:107-112`), so the kernel sees unit paths.
+                path_weight: 1.0,
+            });
+        }
+    }
+    let plan = TensorProductPlan::new(
+        irreps_in1,
+        irreps_in2,
+        irreps_out,
+        instructions,
+        cg_entries,
+        descriptor.weight_numel,
+    )
+    .map_err(MaceLiteError::from)?;
+    Ok(Layer1Plan {
+        output_mask: vec![1.0; descriptor.out_dim],
+        output_mask_f32: vec![1.0; descriptor.out_dim],
+        plan,
+    })
+}
+
+/// Which kernel answered: `"layer1-fast"` or `"generic"`.
+fn layer1_fast_path(plan: &TensorProductPlan) -> bool {
+    plan.input1_dim() == MP0B_PRODUCT0_ROW_LEN
+        && plan.input2_dim() == MP0B_SH_DIM
+        && plan.output_dim() == MP0B_LAYER1_CONV_TP_OUTPUT_ROW_LEN
+        && plan.weight_numel.is_multiple_of(MP0B_NUM_FEATURES)
+        && mp0b_layer1_dynamic_templates(plan).is_some()
+}
+
+/// Layer-1 `conv_tp` forward, f64. Returns the path taken and the node rows.
+pub fn layer1_fwd(
+    prepared: &Layer1Plan,
+    linear_up: &[f64],
+    edge_attrs: &[f64],
+    tp_weights: &[f64],
+    senders: &[usize],
+    receivers: &[usize],
+    num_nodes: usize,
+) -> Result<(&'static str, Vec<f64>), MaceLiteError> {
+    let plan = &prepared.plan;
+    let mut out = vec![0.0; num_nodes * plan.output_dim()];
+    mp0b_apply_conv_tp(
+        Mp0bConvTpInput {
+            plan,
+            linear_up,
+            edge_attrs,
+            tp_weights,
+            output_mask: &prepared.output_mask,
+            senders,
+            receivers,
+        },
+        &mut out,
+    )?;
+    Ok((path_name(layer1_fast_path(plan)), out))
+}
+
+/// Layer-1 `conv_tp` forward, f32.
+pub fn layer1_fwd_f32(
+    prepared: &Layer1Plan,
+    linear_up: &[f32],
+    edge_attrs: &[f32],
+    tp_weights: &[f32],
+    senders: &[usize],
+    receivers: &[usize],
+    num_nodes: usize,
+) -> Result<(&'static str, Vec<f32>), MaceLiteError> {
+    let plan = &prepared.plan;
+    let mut out = vec![0.0f32; num_nodes * plan.output_dim()];
+    mp0b_apply_conv_tp_f32(
+        Mp0bConvTpInputF32 {
+            plan,
+            linear_up,
+            edge_attrs,
+            tp_weights,
+            output_mask: &prepared.output_mask_f32,
+            senders,
+            receivers,
+        },
+        &mut out,
+    )?;
+    Ok((path_name(layer1_fast_path(plan)), out))
+}
+
+fn path_name(fast: bool) -> &'static str {
+    if fast {
+        "layer1-fast"
+    } else {
+        "generic"
+    }
+}
+
+/// Layer-1 `conv_tp` VJP, f64: `(bar_linear_up, bar_edge_attrs, bar_tp_weights)`.
+#[allow(clippy::type_complexity)]
+pub fn layer1_vjp(
+    prepared: &Layer1Plan,
+    linear_up: &[f64],
+    edge_attrs: &[f64],
+    tp_weights: &[f64],
+    bar_scatter_message: &[f64],
+    senders: &[usize],
+    receivers: &[usize],
+) -> Result<(&'static str, (Vec<f64>, Vec<f64>, Vec<f64>)), MaceLiteError> {
+    let plan = &prepared.plan;
+    let gradient = mp0b_apply_conv_tp_vjp(
+        Mp0bConvTpInput {
+            plan,
+            linear_up,
+            edge_attrs,
+            tp_weights,
+            output_mask: &prepared.output_mask,
+            senders,
+            receivers,
+        },
+        bar_scatter_message,
+    )?;
+    Ok((
+        path_name(layer1_fast_path(plan)),
+        (
+            gradient.bar_linear_up,
+            gradient.bar_edge_attrs,
+            gradient.bar_tp_weights,
+        ),
+    ))
+}
+
+/// Layer-1 `conv_tp` VJP, f32.
+#[allow(clippy::type_complexity)]
+pub fn layer1_vjp_f32(
+    prepared: &Layer1Plan,
+    linear_up: &[f32],
+    edge_attrs: &[f32],
+    tp_weights: &[f32],
+    bar_scatter_message: &[f32],
+    senders: &[usize],
+    receivers: &[usize],
+) -> Result<(&'static str, (Vec<f32>, Vec<f32>, Vec<f32>)), MaceLiteError> {
+    let plan = &prepared.plan;
+    let gradient = mp0b_apply_conv_tp_vjp_f32(
+        Mp0bConvTpInputF32 {
+            plan,
+            linear_up,
+            edge_attrs,
+            tp_weights,
+            output_mask: &prepared.output_mask_f32,
+            senders,
+            receivers,
+        },
+        bar_scatter_message,
+    )?;
+    Ok((
+        path_name(layer1_fast_path(plan)),
+        (
+            gradient.bar_linear_up,
+            gradient.bar_edge_attrs,
+            gradient.bar_tp_weights,
+        ),
+    ))
+}
